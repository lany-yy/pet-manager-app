#:kivy 2.1.0

<DailyManagementScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.95, 0.97, 0.99, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 顶部标题栏
        BoxLayout:
            size_hint_y: 0.12
            spacing: 10
            padding: 5

            Button:
                text: '< 返回'
                size_hint_x: 0.2
                font_size: '16sp'
                background_color: 0.9, 0.9, 0.9, 1
                on_press: root.go_back()

            Label:
                text: '日常管理'
                font_size: '22sp'
                bold: True
                color: 0.8, 0.6, 0.2, 1
                size_hint_x: 0.6

            Label:
                text: root.pet_name
                font_size: '14sp'
                color: 0.5, 0.5, 0.5, 1
                size_hint_x: 0.2
                halign: 'right'

        # 今日喂食总量
        BoxLayout:
            size_hint_y: 0.15
            orientation: 'vertical'
            padding: 15
            canvas:
                Color:
                    rgba: 0.95, 0.92, 0.85, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]

            Label:
                text: '今日喂食总量'
                font_size: '14sp'
                color: 0.5, 0.5, 0.5, 1
                halign: 'center'

            Label:
                text: f'{root.today_total_amount:.0f} g'
                font_size: '28sp'
                bold: True
                color: 0.8, 0.6, 0.2, 1
                halign: 'center'

        # 添加喂食按钮
        Button:
            text: '+ 添加喂食记录'
            size_hint_y: 0.08
            font_size: '16sp'
            background_color: 0.8, 0.6, 0.2, 1
            color: 1, 1, 1, 1
            canvas.before:
                Color:
                    rgba: 0.8, 0.6, 0.2, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8, 8, 8, 8]
            on_press: root.toggle_add_feeding()

        # 添加表单
        BoxLayout:
            id: add_form
            orientation: 'vertical'
            size_hint_y: None
            height: 130 if root.show_add_feeding else 0
            padding: 15
            spacing: 12
            canvas:
                Color:
                    rgba: 0.95, 0.98, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10, 10, 10, 10]
            opacity: 1 if root.show_add_feeding else 0

            BoxLayout:
                spacing: 15

                BoxLayout:
                    size_hint_x: 0.5
                    orientation: 'vertical'
                    spacing: 5

                    Label:
                        text: '食物类型'
                        font_size: '14sp'
                        color: 0.3, 0.3, 0.3, 1

                    Spinner:
                        text: root.food_type_input
                        values: ['干粮', '湿粮', '零食', '罐头', '生骨肉', '其他']
                        font_size: '14sp'
                        on_text: root.food_type_input = self.text

                BoxLayout:
                    size_hint_x: 0.5
                    orientation: 'vertical'
                    spacing: 5

                    Label:
                        text: '喂食量(g)'
                        font_size: '14sp'
                        color: 0.3, 0.3, 0.3, 1

                    TextInput:
                        hint_text: '输入克数'
                        input_type: 'number'
                        multiline: False
                        font_size: '14sp'
                        padding: [10, 5]
                        canvas:
                            Color:
                                rgba: 1, 1, 1, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [5, 5, 5, 5]
                            Color:
                                rgba: 0.8, 0.8, 0.8, 1
                            Line:
                                rectangle: (self.x, self.y, self.width, self.height)
                                width: 1

            BoxLayout:
                spacing: 15

                Button:
                    text: '取消'
                    size_hint_x: 0.5
                    font_size: '14sp'
                    background_color: 0.9, 0.9, 0.9, 1
                    on_press: root.toggle_add_feeding()

                Button:
                    text: '保存'
                    size_hint_x: 0.5
                    font_size: '14sp'
                    background_color: 0.8, 0.6, 0.2, 1
                    color: 1, 1, 1, 1
                    on_press: root.add_feeding()

        # 快捷操作
        BoxLayout:
            size_hint_y: 0.08
            padding: [15, 0]

            Label:
                text: '快捷操作'
                font_size: '16sp'
                bold: True
                color: 0.3, 0.3, 0.3, 1

        GridLayout:
            cols: 2
            spacing: 12
            size_hint_y: 0.12
            padding: [15, 0, 15, 0]

            Button:
                text: '🚶 遛狗'
                font_size: '16sp'
                background_color: 0.3, 0.7, 0.5, 1
                color: 1, 1, 1, 1
                canvas.before:
                    Color:
                        rgba: 0.3, 0.7, 0.5, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                on_press: root.record_walk()

            Button:
                text: '🧴 更换猫砂'
                font_size: '16sp'
                background_color: 0.6, 0.5, 0.8, 1
                color: 1, 1, 1, 1
                canvas.before:
                    Color:
                        rgba: 0.6, 0.5, 0.8, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10, 10, 10, 10]
                on_press: root.record_litter()

        # 今日喂食记录
        BoxLayout:
            size_hint_y: 0.08
            padding: [15, 0]

            Label:
                text: '今日喂食记录'
                font_size: '16sp'
                bold: True
                color: 0.3, 0.3, 0.3, 1

        ScrollView:
            size_hint_y: 0.27

            GridLayout:
                cols: 1
                spacing: 10
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: '暂无喂食记录'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: 60
                    halign: 'center'