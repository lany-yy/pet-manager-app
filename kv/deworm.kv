#:kivy 2.1.0

<DewormScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.95, 0.97, 0.99, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 顶部标题栏
        BoxLayout:
            size_hint_y: 0.12
            spacing: 10
            padding: 5

            Button:
                text: '< 返回'
                size_hint_x: 0.2
                font_size: '16sp'
                background_color: 0.9, 0.9, 0.9, 1
                on_press: root.go_back()

            Label:
                text: '驱虫记录'
                font_size: '22sp'
                bold: True
                color: 0.6, 0.5, 0.8, 1
                size_hint_x: 0.6

            Label:
                text: root.pet_name
                font_size: '14sp'
                color: 0.5, 0.5, 0.5, 1
                size_hint_x: 0.2
                halign: 'right'

        # 添加驱虫按钮
        Button:
            text: '+ 添加驱虫记录'
            size_hint_y: 0.08
            font_size: '16sp'
            background_color: 0.6, 0.5, 0.8, 1
            color: 1, 1, 1, 1
            canvas.before:
                Color:
                    rgba: 0.6, 0.5, 0.8, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8, 8, 8, 8]
            on_press: root.toggle_add_form()

        # 添加表单
        BoxLayout:
            id: add_form
            orientation: 'vertical'
            size_hint_y: None
            height: 250 if root.show_add_form else 0
            padding: 15
            spacing: 12
            canvas:
                Color:
                    rgba: 0.95, 0.98, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10, 10, 10, 10]
            opacity: 1 if root.show_add_form else 0

            # 驱虫类型
            BoxLayout:
                size_hint_y: 0.3
                orientation: 'vertical'
                spacing: 5

                Label:
                    text: '驱虫类型'
                    font_size: '14sp'
                    bold: True
                    color: 0.3, 0.3, 0.3, 1

                Spinner:
                    text: root.deworm_type_input
                    values: ['体内', '体外', '内外同驱']
                    font_size: '14sp'
                    canvas:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8, 8, 8, 8]
                        Color:
                            rgba: 0.8, 0.8, 0.8, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1
                    on_text: root.deworm_type_input = self.text

            # 驱虫日期
            BoxLayout:
                size_hint_y: 0.3
                orientation: 'vertical'
                spacing: 5

                Label:
                    text: '驱虫日期'
                    font_size: '14sp'
                    bold: True
                    color: 0.3, 0.3, 0.3, 1

                TextInput:
                    hint_text: 'YYYY-MM-DD'
                    multiline: False
                    font_size: '14sp'
                    padding: [10, 8]
                    canvas:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [8, 8, 8, 8]
                        Color:
                            rgba: 0.8, 0.8, 0.8, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1

            # 操作按钮
            BoxLayout:
                size_hint_y: 0.25
                spacing: 15

                Button:
                    text: '取消'
                    size_hint_x: 0.5
                    font_size: '14sp'
                    background_color: 0.9, 0.9, 0.9, 1
                    on_press: root.toggle_add_form()

                Button:
                    text: '保存'
                    size_hint_x: 0.5
                    font_size: '14sp'
                    background_color: 0.6, 0.5, 0.8, 1
                    color: 1, 1, 1, 1
                    on_press: root.add_deworm()

        # 驱虫记录列表标题
        BoxLayout:
            size_hint_y: 0.08
            padding: [15, 0]

            Label:
                text: '驱虫记录'
                font_size: '16sp'
                bold: True
                color: 0.3, 0.3, 0.3, 1

        # 驱虫记录列表
        ScrollView:
            size_hint_y: 0.54

            GridLayout:
                cols: 1
                spacing: 10
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: '暂无驱虫记录'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: 60
                    halign: 'center'