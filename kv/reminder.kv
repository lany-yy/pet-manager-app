#:kivy 2.1.0

<ReminderScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.95, 0.97, 0.99, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 顶部标题栏
        BoxLayout:
            size_hint_y: 0.12
            spacing: 10
            padding: 5

            Button:
                text: '< 返回'
                size_hint_x: 0.2
                font_size: '16sp'
                background_color: 0.9, 0.9, 0.9, 1
                on_press: app.get_manager().current = 'main'

            Label:
                text: '今日提醒'
                font_size: '22sp'
                bold: True
                color: 0.8, 0.6, 0.2, 1
                size_hint_x: 0.6

            Label:
                text: f'{root.today_count} 项'
                font_size: '14sp'
                color: 0.5, 0.5, 0.5, 1
                size_hint_x: 0.2
                halign: 'right'

        # 已逾期提醒
        BoxLayout:
            size_hint_y: 0.08
            padding: [15, 0]

            Label:
                text: '🔴 已逾期'
                font_size: '16sp'
                bold: True
                color: 0.8, 0.3, 0.3, 1

        ScrollView:
            size_hint_y: 0.25

            GridLayout:
                cols: 1
                spacing: 10
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: '暂无逾期提醒'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: 40
                    halign: 'center'

        # 今日到期提醒
        BoxLayout:
            size_hint_y: 0.08
            padding: [15, 0]

            Label:
                text: '🟡 今日到期'
                font_size: '16sp'
                bold: True
                color: 0.8, 0.6, 0.2, 1

        ScrollView:
            size_hint_y: 0.47

            GridLayout:
                cols: 1
                spacing: 10
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: '暂无今日到期提醒'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: 60
                    halign: 'center'