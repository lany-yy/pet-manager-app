#:kivy 2.1.0

<SettingsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.95, 0.97, 0.99, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 顶部标题栏
        BoxLayout:
            size_hint_y: 0.12
            spacing: 10
            padding: 5

            Button:
                text: '< 返回'
                size_hint_x: 0.2
                font_size: '16sp'
                background_color: 0.9, 0.9, 0.9, 1
                on_press: root.go_back()

            Label:
                text: '设置'
                font_size: '22sp'
                bold: True
                color: 0.5, 0.5, 0.6, 1
                size_hint_x: 0.6

            Widget:
                size_hint_x: 0.2

        # 设置项列表
        ScrollView:
            size_hint_y: 0.78

            GridLayout:
                cols: 1
                spacing: 10
                padding: 10
                size_hint_y: None
                height: self.minimum_height

                # 数据备份
                Button:
                    text: '📦 备份数据库'
                    size_hint_y: None
                    height: 60
                    font_size: '18sp'
                    background_color: 0.95, 0.97, 0.99, 1
                    color: 0.3, 0.3, 0.3, 1
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10, 10, 10, 10]
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1
                    on_press: root.backup_database()

                # 恢复数据
                Button:
                    text: '🔄 恢复数据'
                    size_hint_y: None
                    height: 60
                    font_size: '18sp'
                    background_color: 0.95, 0.97, 0.99, 1
                    color: 0.3, 0.3, 0.3, 1
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10, 10, 10, 10]
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1
                    on_press: root.restore_database()

                # 清除数据
                Button:
                    text: '🗑️ 清除所有数据'
                    size_hint_y: None
                    height: 60
                    font_size: '18sp'
                    background_color: 0.95, 0.97, 0.99, 1
                    color: 0.8, 0.3, 0.3, 1
                    canvas.before:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10, 10, 10, 10]
                        Color:
                            rgba: 0.9, 0.9, 0.9, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1
                    on_press: root.clear_data()

        # 版本信息
        Label:
            size_hint_y: 0.1
            text: '宠物管理系统 v1.0.0'
            font_size: '12sp'
            color: 0.5, 0.5, 0.5, 1
            halign: 'center'