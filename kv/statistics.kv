#:kivy 2.1.0

<StatisticsScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.95, 0.97, 0.99, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 顶部标题栏
        BoxLayout:
            size_hint_y: 0.12
            spacing: 10
            padding: 5

            Button:
                text: '< 返回'
                size_hint_x: 0.2
                font_size: '16sp'
                background_color: 0.9, 0.9, 0.9, 1
                on_press: root.go_back()

            Label:
                text: '健康统计'
                font_size: '22sp'
                bold: True
                color: 0.6, 0.5, 0.8, 1
                size_hint_x: 0.6

            Widget:
                size_hint_x: 0.2

        # 统计卡片网格
        GridLayout:
            cols: 2
            spacing: 12
            padding: 10
            size_hint_y: 0.45

            # 宠物数量
            BoxLayout:
                orientation: 'vertical'
                padding: 15
                canvas:
                    Color:
                        rgba: 0.9, 0.95, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

                Label:
                    text: '宠物总数'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    halign: 'center'

                Label:
                    text: str(root.stats.get('pet_count', 0))
                    font_size: '32sp'
                    bold: True
                    color: 0.2, 0.6, 0.8, 1
                    halign: 'center'

            # 疫苗完成率
            BoxLayout:
                orientation: 'vertical'
                padding: 15
                canvas:
                    Color:
                        rgba: 0.9, 0.98, 0.95, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

                Label:
                    text: '疫苗完成率'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    halign: 'center'

                Label:
                    text: f"{root.stats.get('vaccine_rate', 0)}%"
                    font_size: '32sp'
                    bold: True
                    color: 0.3, 0.7, 0.5, 1
                    halign: 'center'

            # 体重记录数
            BoxLayout:
                orientation: 'vertical'
                padding: 15
                canvas:
                    Color:
                        rgba: 0.95, 0.92, 0.85, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

                Label:
                    text: '体重记录'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    halign: 'center'

                Label:
                    text: str(root.stats.get('weight_count', 0))
                    font_size: '32sp'
                    bold: True
                    color: 0.8, 0.6, 0.2, 1
                    halign: 'center'

            # 驱虫次数
            BoxLayout:
                orientation: 'vertical'
                padding: 15
                canvas:
                    Color:
                        rgba: 0.95, 0.92, 0.98, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [12, 12, 12, 12]

                Label:
                    text: '驱虫次数'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    halign: 'center'

                Label:
                    text: str(root.stats.get('deworm_count', 0))
                    font_size: '32sp'
                    bold: True
                    color: 0.6, 0.5, 0.8, 1
                    halign: 'center'

        # 待处理提醒
        BoxLayout:
            size_hint_y: 0.15
            orientation: 'vertical'
            padding: 15
            canvas:
                Color:
                    rgba: 0.98, 0.92, 0.92, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]

            Label:
                text: '待处理提醒'
                font_size: '14sp'
                color: 0.5, 0.5, 0.5, 1
                halign: 'center'

            Label:
                text: f'{root.stats.get("active_reminders", 0)} 项'
                font_size: '28sp'
                bold: True
                color: 0.8, 0.3, 0.3, 1
                halign: 'center'

        # 导出按钮
        Button:
            text: '📄 导出健康报告'
            size_hint_y: 0.08
            font_size: '16sp'
            background_color: 0.6, 0.5, 0.8, 1
            color: 1, 1, 1, 1
            canvas.before:
                Color:
                    rgba: 0.6, 0.5, 0.8, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8, 8, 8, 8]
            on_press: root.export_report()