#:kivy 2.1.0

<VaccineScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 顶部标题栏
        BoxLayout:
            size_hint_y: 0.12
            spacing: 10
            padding: 5

            Button:
                text: '< 返回'
                size_hint_x: 0.2
                background_color: 0.9, 0.9, 0.9, 1
                on_press: root.go_back()

            Label:
                text: '疫苗记录'
                font_size: '22sp'
                bold: True
                size_hint_x: 0.6
                color: 0.2, 0.6, 0.8, 1

            Label:
                text: root.pet_name
                font_size: '14sp'
                color: 0.5, 0.5, 0.5, 1
                size_hint_x: 0.2
                halign: 'right'

        # 添加疫苗按钮
        Button:
            text: '+ 添加疫苗记录'
            size_hint_y: 0.08
            background_color: 0.2, 0.6, 0.8, 1
            color: 1, 1, 1, 1
            on_press: root.toggle_add_form()

        # 添加表单（默认隐藏）
        BoxLayout:
            id: add_form
            orientation: 'vertical'
            size_hint_y: None
            height: 300 if root.show_add_form else 0
            padding: 15
            spacing: 12
            canvas:
                Color:
                    rgba: 0.95, 0.98, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10, 10, 10, 10]
            opacity: 1 if root.show_add_form else 0

            # 疫苗名称
            BoxLayout:
                size_hint_y: 0.22
                orientation: 'vertical'
                spacing: 5

                Label:
                    text: '疫苗名称 *'
                    font_size: '14sp'
                    bold: True
                    color: 0.3, 0.3, 0.3, 1

                TextInput:
                    id: vaccine_name
                    hint_text: '例如：狂犬疫苗、六联疫苗'
                    multiline: False
                    font_size: '14sp'
                    padding: [10, 5]
                    canvas:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [5, 5, 5, 5]
                        Color:
                            rgba: 0.8, 0.8, 0.8, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1

            # 接种日期
            BoxLayout:
                size_hint_y: 0.22
                orientation: 'vertical'
                spacing: 5

                Label:
                    text: '接种日期 *'
                    font_size: '14sp'
                    bold: True
                    color: 0.3, 0.3, 0.3, 1

                TextInput:
                    id: vaccine_date
                    hint_text: 'YYYY-MM-DD'
                    multiline: False
                    font_size: '14sp'
                    padding: [10, 5]
                    canvas:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [5, 5, 5, 5]
                        Color:
                            rgba: 0.8, 0.8, 0.8, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1

            # 下次到期日期
            BoxLayout:
                size_hint_y: 0.22
                orientation: 'vertical'
                spacing: 5

                Label:
                    text: '下次到期日期'
                    font_size: '14sp'
                    bold: True
                    color: 0.3, 0.3, 0.3, 1

                TextInput:
                    id: next_due_date
                    hint_text: 'YYYY-MM-DD（可选）'
                    multiline: False
                    font_size: '14sp'
                    padding: [10, 5]
                    canvas:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [5, 5, 5, 5]
                        Color:
                            rgba: 0.8, 0.8, 0.8, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1

            # 备注
            BoxLayout:
                size_hint_y: 0.22
                orientation: 'vertical'
                spacing: 5

                Label:
                    text: '备注'
                    font_size: '14sp'
                    bold: True
                    color: 0.3, 0.3, 0.3, 1

                TextInput:
                    id: vaccine_notes
                    hint_text: '添加备注信息（可选）'
                    multiline: False
                    font_size: '14sp'
                    padding: [10, 5]
                    canvas:
                        Color:
                            rgba: 1, 1, 1, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [5, 5, 5, 5]
                        Color:
                            rgba: 0.8, 0.8, 0.8, 1
                        Line:
                            rectangle: (self.x, self.y, self.width, self.height)
                            width: 1

            # 操作按钮
            BoxLayout:
                size_hint_y: 0.12
                spacing: 15

                Button:
                    text: '取消'
                    size_hint_x: 0.5
                    background_color: 0.9, 0.9, 0.9, 1
                    font_size: '14sp'
                    on_press: root.toggle_add_form()

                Button:
                    text: '保存'
                    size_hint_x: 0.5
                    background_color: 0.2, 0.6, 0.8, 1
                    color: 1, 1, 1, 1
                    font_size: '14sp'
                    on_press: root.add_vaccine()

        # 疫苗记录列表标题
        BoxLayout:
            size_hint_y: 0.08
            padding: [10, 0]

            Label:
                text: '疫苗记录'
                font_size: '16sp'
                bold: True
                color: 0.3, 0.3, 0.3, 1

        # 疫苗记录列表
        ScrollView:
            size_hint_y: 0.55

            GridLayout:
                cols: 1
                spacing: 10
                padding: 5
                size_hint_y: None
                height: self.minimum_height

                # 空状态提示
                Label:
                    text: '暂无疫苗记录'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: 60
                    halign: 'center'