#:kivy 2.1.0

<WeightScreen>:
    BoxLayout:
        orientation: 'vertical'
        padding: 15
        spacing: 10
        canvas.before:
            Color:
                rgba: 0.95, 0.97, 0.99, 1
            Rectangle:
                pos: self.pos
                size: self.size

        # 顶部标题栏
        BoxLayout:
            size_hint_y: 0.12
            spacing: 10
            padding: 5

            Button:
                text: '< 返回'
                size_hint_x: 0.2
                font_size: '16sp'
                background_color: 0.9, 0.9, 0.9, 1
                on_press: root.go_back()

            Label:
                text: '体重记录'
                font_size: '22sp'
                bold: True
                color: 0.2, 0.6, 0.8, 1
                size_hint_x: 0.6

            Label:
                text: root.pet_name
                font_size: '14sp'
                color: 0.5, 0.5, 0.5, 1
                size_hint_x: 0.2
                halign: 'right'

        # 当前体重显示
        BoxLayout:
            size_hint_y: 0.18
            orientation: 'vertical'
            padding: 15
            canvas:
                Color:
                    rgba: 0.9, 0.95, 1, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]

            Label:
                text: '最新体重'
                font_size: '14sp'
                color: 0.5, 0.5, 0.5, 1
                halign: 'center'

            Label:
                text: f'{root.latest_weight:.1f} kg' if root.latest_weight > 0 else '暂无数据'
                font_size: '32sp'
                bold: True
                color: 0.2, 0.6, 0.8, 1
                halign: 'center'

        # 添加体重输入
        BoxLayout:
            size_hint_y: 0.1
            padding: [15, 0]
            spacing: 15

            TextInput:
                id: weight_input
                hint_text: '输入体重(kg)'
                input_type: 'number'
                multiline: False
                font_size: '14sp'
                size_hint_x: 0.5
                padding: [10, 8]
                canvas:
                    Color:
                        rgba: 1, 1, 1, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8, 8, 8, 8]
                    Color:
                        rgba: 0.8, 0.8, 0.8, 1
                    Line:
                        rectangle: (self.x, self.y, self.width, self.height)
                        width: 1

            Button:
                text: '添加记录'
                size_hint_x: 0.5
                font_size: '16sp'
                background_color: 0.3, 0.7, 0.5, 1
                color: 1, 1, 1, 1
                canvas.before:
                    Color:
                        rgba: 0.3, 0.7, 0.5, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8, 8, 8, 8]
                on_press: root.add_weight()

        # 体重历史列表
        BoxLayout:
            size_hint_y: 0.08
            padding: [15, 0]

            Label:
                text: '历史记录'
                font_size: '16sp'
                bold: True
                color: 0.3, 0.3, 0.3, 1

        # 记录列表
        ScrollView:
            size_hint_y: 0.52

            GridLayout:
                cols: 1
                spacing: 10
                size_hint_y: None
                height: self.minimum_height

                Label:
                    text: '暂无体重记录'
                    font_size: '14sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_y: None
                    height: 60
                    halign: 'center'